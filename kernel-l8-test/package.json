{
  "name": "kernel-l8-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "L8 Relation + Attachment Property Testing Suite",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mutation": "tsx mutation/run.ts",
    "equivalence": "tsx mutation/equivalence.ts",
    "verify": "npm run typecheck && npm run test && npm run mutation && npm run equivalence"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "fast-check": "^3.19.0",
    "tsx": "4.23.8",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
