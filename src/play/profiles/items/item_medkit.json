{
  "id": "item_medkit_001",
  "name": "急救包",
  "category": "consumable",
  "classComposition": {
    "classIds": [
      "item.class.consumable"
    ],
    "capabilityIds": [
      "item.capability.recover"
    ]
  },
  "volume": 1,
  "tags": [
    "医疗",
    "恢复",
    "消耗品",
    "重伤治疗"
  ],
  "stackable": true,
  "grantedStates": [],
  "description": "标准配置的急救包，内含止血剂和消炎药膏。直接使血量回到 4 点。",
  "actions": [
    {
      "name": "使用急救包",
      "apCost": 1,
      "target": "self",
      "description": "从背包使用，消耗1 AP，直接使血量回至 4 点",
      "effects": [
        {
          "op": "prop.set",
          "path": "entities.{actor}.props.hp",
          "value": 4,
          "condition": "entities.{actor}.props.hp < 4",
          "clamp": {
            "min": 0,
            "max": 5
          }
        }
      ],
      "kernelOps": [
        "prop.set"
      ]
    }
  ],
  "kernelOps": [
    "prop.set"
  ],
  "pendingKernelOps": [
    "list.remove"
  ],
  "pendingKernelOpsNote": "消耗品用后从背包移除仍未建模：需要先确定背包容器的列表路径，才能给出 list.remove 的完整参数。",
  "mvp": true,
  "weight": "medium",
  "source": [
    "地图生成",
    "商店",
    "搜刮"
  ],
  "rarity": "uncommon",
  "unresolvedIssues": [
    {
      "code": "ITEM-MEDKIT-AP-COST",
      "status": "resolved",
      "issue": "来源文档对医疗包的使用成本同时出现 0 AP 与 1 AP 两种写法，本 profile 取 1 AP。",
      "decision": "2026-08-13 项目所有者裁决：消耗 1 AP 不改；同时裁定本物品更名「急救包」，效果为直接使血量回至 4 点（prop.set 设定 hp=4，非增量）。"
    }
  ],
  "itemParameters": {
    "item.capability.recover": {
      "targetSelector": "self",
      "targetProperty": "hp",
      "amount": "actions[].effects[0].value",
      "applicationTiming": "on-use",
      "operation": "prop.set"
    }
  }
}
