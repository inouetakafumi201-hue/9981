{
  "id": "npc_guard_elite",
  "name": "精英守卫",
  "type": "guard",
  "hp": 4,
  "perception": {
    "vision": 4,
    "hearing": 4,
    "alertThreshold": 2
  },
  "fsm": {
    "initialState": "patrolling",
    "states": {
      "patrolling": {
        "onEnter": ["PatrolRoute", "StartPatrol"],
        "transitions": [
          {
            "event": "OnNoise",
            "condition": "perception.hearing >= perception.alertThreshold",
            "target": "listening",
            "kernelEvent": "NPC_Alert"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      },
      "listening": {
        "onEnter": ["InvestigateSound"],
        "transitions": [
          {
            "event": "OnArriveAtSoundSource",
            "condition": "!playerInSight",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      },
      "chasing": {
        "onEnter": ["LockTarget", "MoveToLastKnownPosition"],
        "transitions": [
          {
            "event": "OnArriveAtLastSeen",
            "condition": "!playerInSight",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "sameMicroScene",
            "target": "attacking",
            "kernelEvent": "NPC_Engaging"
          }
        ]
      },
      "attacking": {
        "onEnter": ["SelectWeapon", "AttackTarget"],
        "transitions": [
          {
            "event": "OnTargetDowned",
            "condition": "target.hp <= 0",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerLeft",
            "condition": "!sameMicroScene && distance > 1",
            "target": "chasing",
            "kernelEvent": "NPC_ResumeChase"
          }
        ]
      },
      "returning": {
        "onEnter": ["ChooseReturnPath", "ReturnToNearestPatrolLine"],
        "transitions": [
          {
            "event": "OnArriveAtPatrolPath",
            "condition": "onPatrolRoute",
            "target": "patrolling",
            "kernelEvent": "NPC_ResumePatrol"
          },
          {
            "event": "OnNoise",
            "condition": "perception.hearing >= perception.alertThreshold",
            "target": "listening",
            "kernelEvent": "NPC_Alert"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      }
    },
    "memory": {
      "patrolRoute": [],
      "currentPatrolIndex": 0,
      "lastSeenPosition": null,
      "lastKnownSoundSource": null
    },
    "returnPolicy": {
      "pathSelection": "nearest",
      "algorithm": "approximate-nearest-patrol-line",
      "description": "返回状态用近似算法选择唯一一条路径，回到最近的巡逻线路；因返回可携带与巡逻不同的配置，故以独立状态表达，不与巡逻合并。"
    }
  },
  "initialEquipment": ["weapon_pistol", "item_bulletproof_vest_medium"],
  "resources": {
    "actionPoints": 1,
    "staminaMax": 3,
    "initialStamina": 0,
    "usesStaminaActively": false,
    "participatesInActionTurn": false,
    "canSpendStaminaOnInitiative": false,
    "description": "D-052：NPC 没有轮次，全部在玩家轮次结束后顺序行动；体力池只用于承受弱点命中与过载压制，不可用于逆转或超逆转。"
  },
  "behaviors": [
    {
      "id": "patrol_behavior",
      "trigger": "State: patrolling",
      "action": "MoveToNextPatrolPoint",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "investigate_behavior",
      "trigger": "State: listening",
      "action": "MoveTowardsSound",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "chase_behavior",
      "trigger": "State: chasing",
      "action": "MoveTowardsTarget",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "combat_behavior",
      "trigger": "State: attacking",
      "action": "MeleeOrRangedAttack",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "ranged_combat",
      "trigger": "State: attacking && distance > 1",
      "action": "RangedAttack",
      "apCost": 1,
      "repeatable": true,
      "priority": 1
    },
    {
      "id": "return_behavior",
      "trigger": "State: returning",
      "action": "MoveToNearestPatrolLine",
      "apCost": 1,
      "repeatable": true
    }
  ],
  "kernelEvents": [
    "OnNoise",
    "OnPlayerEnter",
    "OnArriveAtSoundSource",
    "OnArriveAtLastSeen",
    "OnTargetDowned",
    "OnPlayerLeft",
    "NPC_Alert",
    "NPC_DetectedPlayer",
    "NPC_Returning",
    "NPC_ResumePatrol",
    "NPC_Engaging",
    "NPC_ResumeChase"
  ],
  "tags": ["ai-significant", "hostile", "guard", "elite"],
  "description": "精英守卫，感知更高、装备更好，会使用远程武器。警觉阈值更低，更快响应声音。使用五状态守卫范式行动。",
  "designNotes": {
    "n001Resolution": "NPC FSM是AI行为状态，与实体的StateComponent完全分离。",
    "n013Resolution": "MVP不实现sleeping状态。",
    "n010Resolution": "所有状态转换通过kernelEvents触发。",
    "n004Resolution": "遵循1-5铁律：hp=4, vision=4, hearing=4",
    "alertThresholdNote": "alertThreshold=2意味着比普通守卫更容易警觉"
  },
  "classComposition": {
    "behaviorClassId": "npc.class.guard",
    "capabilityIds": [
      "npc.capability.patrol",
      "npc.capability.perceive",
      "npc.capability.investigate",
      "npc.capability.chase",
      "npc.capability.attack",
      "npc.capability.remember",
      "npc.capability.event_driven"
    ]
  },
  "behaviorParameters": {
    "npc.capability.patrol": {
      "routeRef": "route.guard_elite_patrol",
      "movementPolicyRef": "policy.guard_elite_patrol_move"
    },
    "npc.capability.perceive": {
      "sensorProfileRef": "policy.guard_elite_perception",
      "detectionPolicyRef": "policy.guard_elite_detection",
      "signalFilterRef": "policy.guard_elite_signal_filter"
    },
    "npc.capability.investigate": {
      "stimulusSourceRef": "position.last_sound_source",
      "searchPolicyRef": "policy.guard_elite_search"
    },
    "npc.capability.chase": {
      "targetSelectorRef": "policy.guard_elite_chase_target",
      "pathPolicyRef": "policy.guard_elite_chase_path"
    },
    "npc.capability.attack": {
      "attackSelectorRef": "policy.guard_elite_attack_select",
      "targetSelectorRef": "policy.guard_elite_attack_target",
      "engagementPolicyRef": "policy.guard_elite_engagement"
    },
    "npc.capability.remember": {
      "memorySlotsRef": "policy.guard_elite_memory"
    },
    "npc.capability.event_driven": {
      "eventBindingsRef": "policy.guard_elite_event_bindings"
    }
  },
  "unresolvedIssues": [
    {
      "code": "NPC-GUARD-STATE-NAMING",
      "status": "resolved",
      "issue": "迁移前目录将守卫统一描述为“五状态守卫范式”，此前 FSM 仅定义 patrolling、listening、chasing、attacking 四个状态。",
      "decision": "2026-08-13 项目所有者裁决：第五状态并非 sleeping，而是独立的 returning（返回）。返回用近似算法选唯一路径回最近巡逻线路，因可与巡逻携带不同配置故解耦成独立状态。守卫五状态范式 = 巡逻、听声、追击、战斗、返回。"
    },
    {
      "code": "NPC-EQUIPMENT-DANGLING-PISTOL",
      "status": "unresolved",
      "issue": "initialEquipment 引用的 weapon_pistol 在玩法层没有对应实例。",
      "decision": "保留原引用不改。玩法层存在两个候选实例（wp_pistol_standard、wp_pistol_quickdraw），选哪一个属于精英守卫的配装取舍，不由审计代为裁决。同批的 armor_medium 已可无歧义地改为 item_bulletproof_vest_medium。"
    }
  ],
  "version": "1.0"
}
