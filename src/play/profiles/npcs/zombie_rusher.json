{
  "id": "npc_zombie_rusher",
  "name": "冲锋僵尸",
  "type": "zombie",
  "hp": 2,
  "perception": {
    "vision": 2,
    "hearing": 2,
    "alertThreshold": 3
  },
  "fsm": {
    "initialState": "sleeping",
    "states": {
      "sleeping": {
        "onEnter": ["SetIdle"],
        "transitions": [
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "Zombie_Attacking"
          },
          {
            "event": "OnNoise",
            "condition": "soundLevel > 0",
            "target": "returning",
            "kernelEvent": "NPC_Awakened"
          },
          {
            "event": "OnTimeElapsed",
            "condition": "turnsPassed >= 1",
            "target": "returning",
            "kernelEvent": "NPC_WakeUp"
          }
        ]
      },
      "returning": {
        "onEnter": ["StaggerToReturnPath", "ReturnToNearestRoute"],
        "transitions": [
          {
            "event": "OnArriveAtRoute",
            "condition": "onPatrolRoute",
            "target": "chasing",
            "kernelEvent": "Zombie_ResumeSearch"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "sameMicroScene",
            "target": "chasing",
            "kernelEvent": "Zombie_Attacking"
          }
        ]
      },
      "chasing": {
        "onEnter": ["LockOnTarget", "BeginChase"],
        "transitions": [
          {
            "event": "OnPlayerEnter",
            "condition": "sameMicroScene",
            "target": "attacking",
            "kernelEvent": "Zombie_Attacking"
          }
        ],
        "noDistractions": true
      },
      "attacking": {
        "onEnter": ["MeleeAttack"],
        "transitions": [
          {
            "event": "OnTargetDowned",
            "condition": "target.hp <= 0",
            "target": "chasing",
            "kernelEvent": "Zombie_ResumeSearch"
          },
          {
            "event": "OnTargetLeft",
            "condition": "!sameMicroScene",
            "target": "chasing",
            "kernelEvent": "Zombie_ResumeSearch"
          }
        ]
      }
    },
    "memory": {
      "lastKnownPosition": null,
      "wakeSource": null
    },
    "returnPolicy": {
      "pathSelection": "nearest",
      "algorithm": "approximate-nearest-route",
      "description": "僵尸苏醒后进入返回状态，用近似算法回到最近的行动路线，随后转入追逐。"
    }
  },
  "initialEquipment": ["weapon_claws"],
  "resources": {
    "actionPoints": 1,
    "staminaMax": 3,
    "initialStamina": 0,
    "usesStaminaActively": false,
    "participatesInActionTurn": false,
    "canSpendStaminaOnInitiative": false,
    "description": "D-052：NPC 没有轮次，全部在玩家轮次结束后顺序行动；体力上限 3 低于玩家的 5，正是「去杀僵尸」能练习弱点与过载压制的收益来源。"
  },
  "behaviors": [
    {
      "id": "chase_behavior",
      "trigger": "State: chasing",
      "action": "MoveTowardsTarget",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "return_behavior",
      "trigger": "State: returning",
      "action": "MoveToNearestRoute",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "melee_combat",
      "trigger": "State: attacking",
      "action": "MeleeAttack",
      "apCost": 1,
      "repeatable": true
    }
  ],
  "kernelEvents": [
    "OnNoise",
    "OnPlayerEnter",
    "OnTimeElapsed",
    "OnTargetDowned",
    "OnTargetLeft",
    "OnArriveAtRoute",
    "NPC_Awakened",
    "NPC_WakeUp",
    "Zombie_Attacking",
    "Zombie_ResumeSearch"
  ],
  "tags": ["ai-significant", "hostile", "zombie", "fast"],
  "description": "冲锋僵尸，反应更快、更激进。看到玩家立即冲锋；被任何声音惊醒或一回合后起床，先进返回状态再转入追逐。",
  "designNotes": {
    "n004Resolution": "hp=2遵循1-5约束。",
    "n013Resolution": "sleeping状态有意义：初始睡眠，被视觉（直接冲锋）或声音（经returning）唤醒，一回合后自然起床。",
    "n007Resolution": "简化版FSM。",
    "n010Resolution": "通过kernelEvents触发。",
    "alertThresholdNote": "冲锋僵尸对声音更敏感，任何声音都会惊醒"
  },
  "zombieSpecific": {
    "speed": 2,
    "canBeExecuted": true,
    "dropsDeathBackpack": true,
    "cannotRespawn": true
  },
  "classComposition": {
    "behaviorClassId": "npc.class.zombie",
    "capabilityIds": [
      "npc.capability.sleep",
      "npc.capability.perceive",
      "npc.capability.chase",
      "npc.capability.attack",
      "npc.capability.remember",
      "npc.capability.event_driven"
    ]
  },
  "behaviorParameters": {
    "npc.capability.sleep": {
      "wakePolicyRef": "policy.zombie_rusher_wake"
    },
    "npc.capability.perceive": {
      "sensorProfileRef": "policy.zombie_rusher_perception",
      "detectionPolicyRef": "policy.zombie_rusher_detection",
      "signalFilterRef": "policy.zombie_rusher_signal_filter"
    },
    "npc.capability.chase": {
      "targetSelectorRef": "policy.zombie_rusher_chase_target",
      "pathPolicyRef": "policy.zombie_rusher_chase_path"
    },
    "npc.capability.attack": {
      "attackSelectorRef": "policy.zombie_rusher_attack_select",
      "targetSelectorRef": "policy.zombie_rusher_attack_target",
      "engagementPolicyRef": "policy.zombie_rusher_engagement"
    },
    "npc.capability.remember": {
      "memorySlotsRef": "policy.zombie_rusher_memory"
    },
    "npc.capability.event_driven": {
      "eventBindingsRef": "policy.zombie_rusher_event_bindings"
    }
  },
  "unresolvedIssues": [
    {
      "code": "NPC-EQUIPMENT-DANGLING-CLAWS",
      "status": "unresolved",
      "issue": "initialEquipment 引用的 weapon_claws 在玩法层没有对应实例，也没有任何近似候选。",
      "decision": "保留原引用不改。补齐需要新增一个「爪击」武器实例并为其设定伤害、体积等玩法数值，属新增玩法内容而非引用修正，不由审计代为裁决。"
    }
  ],
  "version": "1.0"
}
