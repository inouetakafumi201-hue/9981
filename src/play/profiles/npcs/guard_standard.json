{
  "id": "npc_guard_standard",
  "name": "普通守卫",
  "type": "guard",
  "hp": 3,
  "perception": {
    "vision": 3,
    "hearing": 3,
    "alertThreshold": 3
  },
  "fsm": {
    "initialState": "patrolling",
    "states": {
      "patrolling": {
        "onEnter": ["PatrolRoute", "StartPatrol"],
        "transitions": [
          {
            "event": "OnNoise",
            "condition": "perception.hearing >= perception.alertThreshold",
            "target": "listening",
            "kernelEvent": "NPC_Alert"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      },
      "listening": {
        "onEnter": ["InvestigateSound"],
        "transitions": [
          {
            "event": "OnArriveAtSoundSource",
            "condition": "!playerInSight",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      },
      "chasing": {
        "onEnter": ["LockTarget", "MoveToLastKnownPosition"],
        "transitions": [
          {
            "event": "OnArriveAtLastSeen",
            "condition": "!playerInSight",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "sameMicroScene",
            "target": "attacking",
            "kernelEvent": "NPC_Engaging"
          }
        ]
      },
      "attacking": {
        "onEnter": ["SelectWeapon", "AttackTarget"],
        "transitions": [
          {
            "event": "OnTargetDowned",
            "condition": "target.hp <= 0",
            "target": "returning",
            "kernelEvent": "NPC_Returning"
          },
          {
            "event": "OnPlayerLeft",
            "condition": "!sameMicroScene && distance > 1",
            "target": "chasing",
            "kernelEvent": "NPC_ResumeChase"
          }
        ]
      },
      "returning": {
        "onEnter": ["ChooseReturnPath", "ReturnToNearestPatrolLine"],
        "transitions": [
          {
            "event": "OnArriveAtPatrolPath",
            "condition": "onPatrolRoute",
            "target": "patrolling",
            "kernelEvent": "NPC_ResumePatrol"
          },
          {
            "event": "OnNoise",
            "condition": "perception.hearing >= perception.alertThreshold",
            "target": "listening",
            "kernelEvent": "NPC_Alert"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "chasing",
            "kernelEvent": "NPC_DetectedPlayer"
          }
        ]
      }
    },
    "memory": {
      "patrolRoute": [],
      "currentPatrolIndex": 0,
      "lastSeenPosition": null,
      "lastKnownSoundSource": null
    },
    "returnPolicy": {
      "pathSelection": "nearest",
      "algorithm": "approximate-nearest-patrol-line",
      "description": "返回状态用近似算法选择唯一一条路径，回到最近的巡逻线路；因返回可携带与巡逻不同的配置，故以独立状态表达，不与巡逻合并。"
    }
  },
  "initialEquipment": ["wp_fists", "item_bulletproof_vest_light"],
  "resources": {
    "actionPoints": 1,
    "staminaMax": 3,
    "initialStamina": 0,
    "usesStaminaActively": false,
    "participatesInActionTurn": false,
    "canSpendStaminaOnInitiative": false,
    "description": "D-052：NPC 没有轮次，全部在玩家轮次结束后顺序行动；体力池只用于承受弱点命中与过载压制，不可用于逆转或超逆转。"
  },
  "behaviors": [
    {
      "id": "patrol_behavior",
      "trigger": "State: patrolling",
      "action": "MoveToNextPatrolPoint",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "investigate_behavior",
      "trigger": "State: listening",
      "action": "MoveTowardsSound",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "chase_behavior",
      "trigger": "State: chasing",
      "action": "MoveTowardsTarget",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "combat_behavior",
      "trigger": "State: attacking",
      "action": "MeleeOrRangedAttack",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "return_behavior",
      "trigger": "State: returning",
      "action": "MoveToNearestPatrolLine",
      "apCost": 1,
      "repeatable": true
    }
  ],
  "kernelEvents": [
    "OnNoise",
    "OnPlayerEnter",
    "OnArriveAtSoundSource",
    "OnArriveAtLastSeen",
    "OnTargetDowned",
    "OnPlayerLeft",
    "NPC_Alert",
    "NPC_DetectedPlayer",
    "NPC_Returning",
    "NPC_ResumePatrol",
    "NPC_Engaging",
    "NPC_ResumeChase"
  ],
  "tags": ["ai-significant", "hostile", "guard"],
  "description": "标准守卫，使用五状态守卫范式（巡逻、听声、追击、战斗、返回）行动，返回用近似算法回最近巡逻线路。",
  "designNotes": {
    "n001Resolution": "NPC FSM是AI行为状态，与实体的StateComponent(状态效果)完全分离。FSM控制AI决策，StateComponent控制游戏状态效果。",
    "n013Resolution": "MVP不实现sleeping状态，守卫出生即为patrolling状态。sleeping作为可选扩展。",
    "n010Resolution": "所有状态转换通过kernelEvents触发，确保与UGC事件系统一致。",
    "hpConstraint": "遵循1-5铁律：hp=3"
  },
  "classComposition": {
    "behaviorClassId": "npc.class.guard",
    "capabilityIds": [
      "npc.capability.patrol",
      "npc.capability.perceive",
      "npc.capability.investigate",
      "npc.capability.chase",
      "npc.capability.attack",
      "npc.capability.remember",
      "npc.capability.event_driven"
    ]
  },
  "behaviorParameters": {
    "npc.capability.patrol": {
      "routeRef": "route.guard_patrol",
      "movementPolicyRef": "policy.guard_patrol_move"
    },
    "npc.capability.perceive": {
      "sensorProfileRef": "policy.guard_perception",
      "detectionPolicyRef": "policy.guard_detection",
      "signalFilterRef": "policy.guard_signal_filter"
    },
    "npc.capability.investigate": {
      "stimulusSourceRef": "position.last_sound_source",
      "searchPolicyRef": "policy.guard_search"
    },
    "npc.capability.chase": {
      "targetSelectorRef": "policy.guard_chase_target",
      "pathPolicyRef": "policy.guard_chase_path"
    },
    "npc.capability.attack": {
      "attackSelectorRef": "policy.guard_attack_select",
      "targetSelectorRef": "policy.guard_attack_target",
      "engagementPolicyRef": "policy.guard_engagement"
    },
    "npc.capability.remember": {
      "memorySlotsRef": "policy.guard_memory"
    },
    "npc.capability.event_driven": {
      "eventBindingsRef": "policy.guard_event_bindings"
    }
  },
  "unresolvedIssues": [
    {
      "code": "NPC-GUARD-STATE-NAMING",
      "status": "resolved",
      "issue": "原说明称“五状态守卫范式”，此前 FSM 仅定义 patrolling、listening、chasing、attacking 四个状态。",
      "decision": "2026-08-13 项目所有者裁决：第五状态并非 sleeping，而是独立的 returning（返回）。返回用近似算法选唯一路径回最近巡逻线路，因可与巡逻携带不同配置故解耦成独立状态。守卫五状态范式 = 巡逻、听声、追击、战斗、返回；僵尸等不在此范本内的 NPC 另行定义自己的状态。"
    }
  ],
  "version": "1.0"
}
