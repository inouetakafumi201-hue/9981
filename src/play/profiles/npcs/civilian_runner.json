{
  "id": "npc_civilian_runner",
  "name": "逃跑型平民",
  "type": "civilian",
  "hp": 2,
  "perception": {
    "vision": 2,
    "hearing": 2,
    "alertThreshold": 3
  },
  "fsm": {
    "initialState": "patrolling",
    "states": {
      "patrolling": {
        "onEnter": ["PatrolRandomly"],
        "transitions": [
          {
            "event": "OnNoise",
            "condition": "soundLevel >= perception.alertThreshold",
            "target": "fleeing",
            "kernelEvent": "Civilian_Flee"
          },
          {
            "event": "OnPlayerEnter",
            "condition": "perception.vision >= 2 && sameMicroScene",
            "target": "fleeing",
            "kernelEvent": "Civilian_Flee"
          }
        ]
      },
      "fleeing": {
        "onEnter": ["RunAwayFromThreat", "IncreaseMovement"],
        "transitions": [
          {
            "event": "OnSafeDistance",
            "condition": "distanceFromThreat >= 3 && !threatInSight",
            "target": "patrolling",
            "kernelEvent": "Civilian_Safe"
          }
        ]
      }
    },
    "memory": {
      "patrolRoute": [],
      "currentPatrolIndex": 0,
      "threatPosition": null,
      "fleeOrigin": null
    }
  },
  "initialEquipment": [],
  "resources": {
    "actionPoints": 1,
    "staminaMax": 3,
    "initialStamina": 0,
    "usesStaminaActively": false,
    "participatesInActionTurn": false,
    "canSpendStaminaOnInitiative": false,
    "description": "D-052：NPC 没有轮次，全部在玩家轮次结束后顺序行动；体力池只用于承受弱点命中与过载压制，不可用于逆转或超逆转。"
  },
  "behaviors": [
    {
      "id": "patrol_behavior",
      "trigger": "State: patrolling",
      "action": "MoveRandomly",
      "apCost": 1,
      "repeatable": true
    },
    {
      "id": "flee_behavior",
      "trigger": "State: fleeing",
      "action": "MoveAwayFromThreat",
      "apCost": 1,
      "repeatable": true
    }
  ],
  "kernelEvents": [
    "OnNoise",
    "OnPlayerEnter",
    "OnSafeDistance",
    "Civilian_Flee",
    "Civilian_Safe"
  ],
  "tags": ["ai-significant", "neutral", "civilian"],
  "description": "逃跑型平民，遇到威胁会立即逃跑。可以被玩家处决获得体力。",
  "designNotes": {
    "n001Resolution": "平民使用简化的FSM：patrolling→fleeing。",
    "n004Resolution": "hp=2遵循1-5约束。",
    "n007Resolution": "简化版FSM，无完整五状态。",
    "n010Resolution": "通过kernelEvents触发。",
    "civilianBehavior": "平民不攻击，只是逃跑增加游戏紧张感"
  },
  "civilianSpecific": {
    "canBeExecuted": true,
    "rewardsStaminaOnExecute": true,
    "dropsDeathBackpack": false,
    "hostileToPlayer": false
  },
  "classComposition": {
    "behaviorClassId": "npc.class.civilian",
    "capabilityIds": [
      "npc.capability.patrol",
      "npc.capability.perceive",
      "npc.capability.flee",
      "npc.capability.remember",
      "npc.capability.event_driven"
    ]
  },
  "version": "1.0"
}
