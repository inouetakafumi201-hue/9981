        }
      ]
    }
  ],
  "compositionContract": {
    "classReferenceField": "classComposition.classIds",
    "capabilityReferenceField": "classComposition.capabilityIds",
    "parameterBindingField": "vehicleParameters",
    "playLayerOwnedFieldNames": ["hp", "maxHp", "speed", "armorRating", "healRate", "damageOnCollision", "seats", "cargo", "kernelTopologyOps", "grantedActions"],
    "description": "玩法层以 classComposition 引用载具类与能力，并在上列玩法层字段中提供耐久、速度、装甲、座位与货舱取值。"
  }
