        { "id": "on-host-removal", "name": "宿主移除时回收", "description": "宿主被移除即回收。" },
        { "id": "on-source-removal", "name": "来源移除时回收", "description": "来源被移除即回收。" },
        { "id": "explicit-only", "name": "仅显式回收", "description": "只在显式移除时回收。" }
