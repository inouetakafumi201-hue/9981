      "id": "attachment.class.status",
      "name": "状态附件类",
      "description": "把语义状态类附加到宿主的附件类。它授予的是状态引用，而不是属性修改规则或技能。",
      "defKind": "attachment",
      "semanticFamily": "attachment",
      "abstract": true,
      "typeIdentity": {
        "basis": "required-capability",
        "statement": "状态附件必须授予一个语义状态类引用；授予内容的契约形状是它与属性附件、技能附件的类型分界。"
      },
      "grantedContractKind": "status-reference",
      "requiredCapabilityIds": [
        "attachment.capability.host_binding",
        "attachment.capability.source_binding",
        "attachment.capability.duration_declaration",
        "attachment.capability.stack_behavior",
        "attachment.capability.granted_status_binding",
        "attachment.capability.cleanup"
      ],
      "optionalCapabilityIds": ["attachment.capability.aura_projection"],
      "parameters": [
        { "key": "hostType", "description": "宿主期望引用类型。", "required": true, "valueShape": "expected-reference-type" },
        { "key": "sourceType", "description": "来源期望引用类型。", "required": true, "valueShape": "expected-reference-type" },
        { "key": "durationMode", "description": "持续模式，取自 duration-modes 值集；具体回合数由玩法层绑定。", "required": true, "valueShape": "enum<duration-modes>" },
        { "key": "stackBehavior", "description": "叠加行为，取自 stack-behaviors 值集；层数上限由玩法层绑定。", "required": true, "valueShape": "enum<stack-behaviors>" },
        { "key": "grantedStatusRef", "description": "被授予的语义状态类引用。", "required": true, "valueShape": "reference<status>" },
        { "key": "cleanupBehavior", "description": "回收行为，取自 cleanup-behaviors 值集。", "required": true, "valueShape": "enum<cleanup-behaviors>" }
      ],
      "kernelOps": ["attach.add", "attach.del", "attach.expire"]
    },
