  "compositionContract": {
    "classReferenceField": "classComposition.behaviorClassId",
    "capabilityReferenceField": "classComposition.capabilityIds",
    "parameterBindingField": "behaviorParameters",
    "playLayerOwnedFieldNames": ["vision", "hearing", "alertThreshold", "currentPatrolIndex", "states", "transitions", "neutralFallbackEvaluation"],
    "description": "玩法层以 classComposition 引用行为类与能力，并在 behaviorParameters 与上列玩法层字段中提供感知取值、状态机与回退取值。"
  }
