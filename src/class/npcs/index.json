{
  "schema": "npc-ai-behavior-class-catalog",
  "schemaVersion": "1.0",
  "version": "2.0.0",
  "catalogId": "npc.ai.behaviors",
  "name": "NPC AI 行为基类目录",
  "description": "定义可组合、可继承、可扩展的 AI 行为基类与能力，只声明可配置参数名与声明契约，不包含具体玩法取值、具体巡逻路线或与单一玩法耦合的状态机。",
  "category": "npcs",
  "semanticFamilies": ["ai-behavior"],
  "classificationEvidence": {
    "enumerable": true,
    "enumerationRationale": "行为基类按职责组合可有限列举；当前登记守卫、平民、僵尸三种范式，新增范式需要权威来源与分类理由。",
    "composable": true,
    "compositionRationale": "行为类与巡逻、感知、调查、追逐、攻击、逃离、隐蔽、休眠、记忆、事件驱动等能力组合成具体 NPC 实例。",
    "gameplayIndependent": true,
    "independenceRationale": "行为类不携带感知阈值、巡逻点坐标或与某个玩法模式绑定的状态转换；这些全部由玩法层策略引用提供。"
  },
  "sourceRecords": [
    {
      "sourceFile": ".kiro/specs/l2-base-layer-spec/requirements.md",
      "sourceLocation": {
        "sourceFile": ".kiro/specs/l2-base-layer-spec/requirements.md",
        "section": "Requirement 10: AI 声明式接口、只读投影与职责边界 / 10.1-10.6"
      },
      "precedence": "finalized-l2-contract",
      "classification": "Normative_Contract",
      "owningLayer": "基类层",
      "statementFingerprint": "l2:ai-behavior-family:state-transition-goal-intent-perception-fallback"
    },
    {
      "sourceFile": "docs/L2_基类层/07_AI系统.md",
      "sourceLocation": {
        "sourceFile": "docs/L2_基类层/07_AI系统.md",
        "section": "NPC 行为范式与感知"
      },
      "precedence": "finalized-l2-contract",
      "classification": "Normative_Contract",
      "owningLayer": "基类层",
      "statementFingerprint": "l2:ai-system:npc-behavior-paradigms"
    }
  ],
  "behaviorDeclarationContract": {
    "stateNameField": "states.stateName",
    "transitionField": "transitions",
    "transitionConditionField": "transitions.conditionExprRef",
    "goalReferenceField": "states.goalRefs",
    "intentReferenceField": "states.intentRefs",
    "fallbackStateReferenceField": "fallbackStateRef",
    "perceptionParameterSchemaField": "perceptionParameters",
    "transitionMechanism": "event-driven-only",
    "description": "行为声明契约规定玩法层在何处声明状态名、转换条件、目标引用、意图引用、感知参数与回退状态。基类层不登记任何具体状态名或转换条件，也不在实现内硬编码转换。"
  },
  "perceptionParameterSchema": [
    { "key": "sensorProfileRef", "description": "感知器配置引用；具体视听范围取值归玩法层。", "required": true, "valueShape": "reference<policy>" },
    { "key": "detectionPolicyRef", "description": "发现判定策略引用；具体阈值取值归玩法层。", "required": true, "valueShape": "reference<policy>" },
    { "key": "signalFilterRef", "description": "刺激筛选引用。", "required": true, "valueShape": "reference<policy>" },
    { "key": "visibilityScopeRef", "description": "可见性范围引用；只读投影按该范围裁剪。", "required": true, "valueShape": "reference<policy>" }
  ],
  "evaluationFallbackContract": {
    "neutralFallbackField": "neutralFallbackEvaluation",
    "classification": "Internal_Metric",
    "rationale": "中性回退评估值是策略比较用的内部度量，不是玩家可见玩法数值，因此不套用玩家可见数值范围；具体取值由玩法层策略声明。",
    "invalidEvaluationDiagnosticCode": "AI_EVALUATION_INVALID",
    "description": "求值结果为空、非数值或非有限值时输出评估诊断并采用策略声明的中性回退结果。"
  },
  "consumedKernelInterfaces": [
    "policy",
    "query",
    "belief-slice",
    "visibility",
    "evaluation-guard",
    "deterministic-random"
  ],
  "readOnlyProjectionContract": {
    "writeCapability": "none",
    "actionSubmissionPath": "shared-action-contract",
    "description": "AI 消费方只能读取受授权认知与可见范围裁剪的只读投影；提交动作时复用与非 AI 调用方相同的动作契约与唯一写入通道。"
  },
  "behaviorClasses": [
    {
      "id": "npc.class.guard",
      "name": "守卫行为类",
      "description": "面向巡查、感知、调查、追逐与交战职责的行为组合。",
      "defKind": "policy",
      "semanticFamily": "ai-behavior",
      "abstract": true,
      "policyCategory": "npc-behavior",
      "typeIdentity": {
        "basis": "required-capability",
        "statement": "守卫必须同时具备调查与追逐能力：它在失去目标后返回调查而不是直接放弃，这一必需能力组合与平民、僵尸不同。"
      },
      "requiredCapabilityIds": [
        "npc.capability.patrol",
        "npc.capability.perceive",
        "npc.capability.investigate",
        "npc.capability.chase",
        "npc.capability.attack",
        "npc.capability.remember",
        "npc.capability.event_driven"
      ],
      "optionalCapabilityIds": [
        "npc.capability.flee",
        "npc.capability.hide"
      ],
      "configurableParameterNames": [
        "patrolPolicyRef",
        "perceptionProfileRef",
        "investigationPolicyRef",
        "pursuitPolicyRef",
        "combatPolicyRef",
        "memoryProfileRef",
        "eventBindingsRef"
      ]
    },
    {
      "id": "npc.class.civilian",
      "name": "平民行为类",
      "description": "面向中立角色感知威胁后逃离或隐蔽的行为组合。逃离与隐蔽是可选替代项，具体实例至少组合其中之一。",
      "defKind": "policy",
      "semanticFamily": "ai-behavior",
      "abstract": true,
      "policyCategory": "npc-behavior",
      "typeIdentity": {
        "basis": "invariant",
        "statement": "平民的不变量是不具备攻击能力：感知到威胁后只能规避；守卫与僵尸都具备攻击能力。"
      },
      "requiredCapabilityIds": [
        "npc.capability.patrol",
        "npc.capability.perceive",
        "npc.capability.remember",
        "npc.capability.event_driven"
      ],
      "optionalCapabilityIds": [
        "npc.capability.flee",
        "npc.capability.hide"
      ],
      "requiredCapabilityAlternatives": [
        {
          "id": "npc.class.civilian.avoidance",
          "description": "规避方式至少组合其中一项。",
          "anyOfCapabilityIds": ["npc.capability.flee", "npc.capability.hide"]
        }
      ],
      "forbiddenCapabilityIds": ["npc.capability.attack"],
      "configurableParameterNames": [
        "patrolPolicyRef",
        "perceptionProfileRef",
        "escapePolicyRef",
        "concealmentPolicyRef",
        "memoryProfileRef",
        "eventBindingsRef"
      ]
    },
    {
      "id": "npc.class.zombie",
      "name": "僵尸行为类",
      "description": "面向休眠、感知、持续追逐与近身交战的行为组合。",
      "defKind": "policy",
      "semanticFamily": "ai-behavior",
      "abstract": true,
      "policyCategory": "npc-behavior",
      "typeIdentity": {
        "basis": "required-capability",
        "statement": "僵尸必须具备休眠能力且不具备巡逻与调查能力：它由唤醒策略而不是巡逻路径驱动，这一必需能力组合与守卫、平民不同。"
      },
      "requiredCapabilityIds": [
        "npc.capability.sleep",
        "npc.capability.perceive",
        "npc.capability.chase",
        "npc.capability.attack",
        "npc.capability.remember",
        "npc.capability.event_driven"
      ],
      "optionalCapabilityIds": [],
      "forbiddenCapabilityIds": ["npc.capability.patrol", "npc.capability.investigate"],
      "configurableParameterNames": [
        "dormantPolicyRef",
        "perceptionProfileRef",
        "pursuitPolicyRef",
        "combatPolicyRef",
        "targetPersistencePolicyRef",
        "memoryProfileRef",
        "eventBindingsRef"
      ]
    }
  ],
  "playerAssistanceClasses": [],
  "playerAssistanceNote": "玩家辅助策略与 NPC 行为策略是两个互不兼容的策略类别。当前目录尚未登记任何玩家辅助策略类；登记前不得把 NPC 行为策略指派为玩家辅助策略，反之亦然。",
  "capabilities": [
    {
      "id": "npc.capability.patrol",
      "name": "巡逻",
      "description": "沿外部提供的路径或移动策略执行巡查。路线本身由玩法层提供。",
      "configurableParameterNames": ["routeRef", "movementPolicyRef", "arrivalPolicyRef"]
    },
    {
      "id": "npc.capability.perceive",
      "name": "感知",
      "description": "接收并筛选环境刺激，产生可供其他行为消费的感知结果。感知阈值由玩法层提供。",
      "configurableParameterNames": ["sensorProfileRef", "detectionPolicyRef", "signalFilterRef"]
    },
    {
      "id": "npc.capability.investigate",
      "name": "调查",
      "description": "依据感知结果定位刺激来源并执行搜索。",
      "configurableParameterNames": ["stimulusSourceRef", "searchPolicyRef", "returnPolicyRef"]
    },
    {
      "id": "npc.capability.chase",
      "name": "追逐",
      "description": "选择目标并依据路径策略持续接近目标。",
      "configurableParameterNames": ["targetSelectorRef", "pathPolicyRef", "targetLossPolicyRef"]
    },
    {
      "id": "npc.capability.attack",
      "name": "攻击",
      "description": "在外部交战策略允许时选择并执行攻击动作；动作经统一动作契约提交。",
      "configurableParameterNames": ["attackSelectorRef", "targetSelectorRef", "engagementPolicyRef"]
    },
    {
      "id": "npc.capability.flee",
      "name": "逃离",
      "description": "识别威胁并依据逃生策略远离威胁。",
      "configurableParameterNames": ["threatSelectorRef", "escapeRoutePolicyRef", "safetyPolicyRef"]
    },
    {
      "id": "npc.capability.hide",
      "name": "隐蔽",
      "description": "选择隐蔽位置并维持隐蔽行为。",
      "configurableParameterNames": ["hidingSpotSelectorRef", "concealmentPolicyRef", "emergencePolicyRef"]
    },
    {
      "id": "npc.capability.sleep",
      "name": "休眠",
      "description": "维持休眠行为并响应外部唤醒策略。",
      "configurableParameterNames": ["wakePolicyRef", "idleActionRef"]
    },
    {
      "id": "npc.capability.remember",
      "name": "记忆",
      "description": "维护供行为决策读取的外部定义记忆槽。",
      "configurableParameterNames": ["memorySlotsRef", "retentionPolicyRef"]
    },
    {
      "id": "npc.capability.event_driven",
      "name": "事件驱动",
      "description": "通过外部事件绑定连接行为输入与行为输出；状态转换一律经事件触发。",
      "configurableParameterNames": ["eventBindingsRef"]
    }
  ],
  "valueSets": [
    {
      "id": "npc.valueset.policy_categories",
      "name": "策略类别",
      "description": "AI 策略类别；两个类别互不兼容，不得互相指派。",
      "tokens": [
        { "id": "player-assistance", "name": "玩家辅助", "description": "为玩家提供建议或代理操作的策略类别。" },
        { "id": "npc-behavior", "name": "NPC 行为", "description": "驱动非玩家角色行为的策略类别。" }
      ]
    }
  ],
  "structuralBounds": [],
  "prohibitions": [
    {
      "id": "prohibition.npc.embedded_gameplay_detail",
      "diagnosticCode": "AI_EMBEDDED_GAMEPLAY_DETAIL",
      "statement": "行为类不得内嵌巡逻路线、具体感知阈值、与单一玩法耦合的状态机或具名 NPC 实例。",
      "correction": "只声明策略引用参数名，把路线、阈值与状态机下沉到玩法层 profile。"
    },
    {
      "id": "prohibition.npc.policy_category_mismatch",
      "diagnosticCode": "AI_POLICY_CATEGORY_MISMATCH",
      "statement": "玩家辅助策略不得被指派为 NPC 行为策略，反之亦然。",
      "correction": "按 policyCategory 分别声明并分别引用。"
    },
    {
      "id": "prohibition.npc.redefine_kernel_interface",
      "diagnosticCode": "AI_REDEFINES_L1_INTERFACE",
      "statement": "行为类不得重定义引擎层的策略、查询、认知切片、可见性、求值保护或确定性随机接口，也不得自带搜索算法与随机流实现。",
      "correction": "只消费引擎层接口，把搜索算法、事务安全模拟与随机流机制留在引擎层。"
    },
    {
      "id": "prohibition.npc.projection_write",
      "diagnosticCode": "PROJECTION_WRITE_REJECTED",
      "statement": "AI 消费方不得经只读投影改写语义状态。",
      "correction": "改为经统一动作契约提交请求，由唯一写入通道执行。"
    }
  ],
