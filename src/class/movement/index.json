    },
    {
      "id": "prohibition.movement.pseudo_subtype",
      "diagnosticCode": "INHERIT_GAMEPLAY_VALUE_ONLY_DIFFERENCE",
      "statement": "移动子类型不得仅因速度或成本取值不同而存在。",
      "correction": "改为组合：同一移动类加不同参数取值。"
    }
