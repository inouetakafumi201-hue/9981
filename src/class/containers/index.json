  "classes": [
    {
      "id": "container.class.carried",
      "name": "携带容器类",
      "description": "绑定到实体或物品宿主、内容随宿主位置变化的容器类。",
      "defKind": "item",
      "semanticFamily": "container",
      "abstract": true,
      "contentLocality": "follows-host",
      "typeIdentity": {
        "basis": "invariant",
        "statement": "携带容器的不变量是内容定位跟随宿主：宿主移动时内容不需要额外的空间操作；驻留容器不满足该不变量。"
      },
      "requiredCapabilityIds": [
        "container.capability.host_binding",
        "container.capability.capacity_declaration",
        "container.capability.deposit",
        "container.capability.withdraw"
      ],
      "optionalCapabilityIds": [
        "container.capability.access_condition",
        "container.capability.lockable",
        "container.capability.deposit_disabled",
        "container.capability.derived_content_source"
      ],
      "parameters": [
        { "key": "hostRef", "description": "宿主实体或物品引用。", "required": true, "valueShape": "reference<entity|item>" },
        { "key": "capacityField", "description": "容量参数字段名；容量取值由玩法层绑定。", "required": true, "valueShape": "field-name" },
        { "key": "contentRefs", "description": "内容物品引用集合。", "required": true, "valueShape": "array<reference<item>>" }
      ],
      "kernelOps": ["item.move", "item.create", "item.destroy", "slot.add", "slot.del", "relation.set", "relation.del", "stack.merge", "stack.split"]
    },
    {
      "id": "container.class.stationary",
      "name": "驻留容器类",
      "description": "放置于空间节点或固定实体上、内容不随访问者移动的容器类。",
      "defKind": "entity",
      "semanticFamily": "container",
      "abstract": true,
      "contentLocality": "bound-to-node",
      "typeIdentity": {
        "basis": "legal-relationship",
        "statement": "驻留容器与空间节点存在放置关系，访问需要访问者与该节点满足邻接或在场关系；携带容器不需要这种空间关系。"
      },
      "requiredCapabilityIds": [
        "container.capability.node_placement",
        "container.capability.capacity_declaration",
        "container.capability.deposit",
        "container.capability.withdraw",
        "container.capability.access_condition"
      ],
      "optionalCapabilityIds": [
        "container.capability.lockable",
        "container.capability.deposit_disabled",
        "container.capability.derived_content_source"
      ],
      "parameters": [
        { "key": "nodeRef", "description": "放置该容器的空间节点引用。", "required": true, "valueShape": "reference<node>" },
        { "key": "capacityField", "description": "容量参数字段名；容量取值由玩法层绑定。", "required": true, "valueShape": "field-name" },
        { "key": "contentRefs", "description": "内容物品引用集合。", "required": true, "valueShape": "array<reference<item>>" },
        { "key": "accessConditionRefs", "description": "访问条件定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "kernelOps": ["item.move", "item.create", "item.destroy", "entity.create", "entity.place", "relation.set", "relation.del", "stack.merge", "stack.split"]
    }
  ],
  "capabilities": [
    {
      "id": "container.capability.host_binding",
      "name": "宿主绑定能力",
      "description": "声明携带容器与其宿主的持有关系，使内容定位跟随宿主。",
      "parameters": [
        { "key": "hostRef", "description": "宿主实体或物品引用。", "required": true, "valueShape": "reference<entity|item>" },
        { "key": "hostRelationRef", "description": "持有关系定义引用。", "required": true, "valueShape": "reference<rule>" }
      ],
      "kernelOps": ["relation.set", "relation.del", "slot.add", "slot.del"]
    },
    {
      "id": "container.capability.node_placement",
      "name": "节点放置能力",
      "description": "声明驻留容器所放置的空间节点引用。",
      "parameters": [
        { "key": "nodeRef", "description": "空间节点引用。", "required": true, "valueShape": "reference<node>" }
      ],
      "kernelOps": ["entity.place"]
    },
    {
      "id": "container.capability.capacity_declaration",
      "name": "容量声明能力",
      "description": "声明容量参数字段名与占位度量方式。容量取值由玩法层绑定，基类层不内嵌容量数值。",
      "parameters": [
        { "key": "capacityField", "description": "容量参数字段名。", "required": true, "valueShape": "field-name" },
        { "key": "occupancyMetric", "description": "占位度量方式，取自 occupancy-metrics 值集。", "required": true, "valueShape": "enum<occupancy-metrics>" }
      ],
      "kernelOps": []
    },
    {
      "id": "container.capability.access_condition",
      "name": "访问条件能力",
      "description": "声明访问容器所需的条件引用与访问成本参数字段名；成本取值由玩法层绑定。",
      "parameters": [
        { "key": "accessConditionRefs", "description": "访问条件定义引用集合。", "required": true, "valueShape": "array<reference>" },
        { "key": "accessCostField", "description": "访问成本参数字段名。", "required": false, "valueShape": "field-name" }
      ],
      "kernelOps": []
    },
    {
      "id": "container.capability.deposit",
      "name": "存入能力",
      "description": "声明物品可被存入该容器，以及存入前的合法性条件引用。",
      "parameters": [
        { "key": "depositConditionRefs", "description": "存入条件定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "kernelOps": ["item.move", "stack.merge"]
    },
    {
      "id": "container.capability.withdraw",
      "name": "取出能力",
      "description": "声明物品可从该容器取出，以及取出前的合法性条件引用。",
      "parameters": [
        { "key": "withdrawConditionRefs", "description": "取出条件定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "kernelOps": ["item.move", "stack.split"]
    },
    {
      "id": "container.capability.lockable",
      "name": "可上锁能力",
      "description": "声明容器访问入口可受锁定状态约束，并引用解锁条件。解锁判据取值由玩法层绑定。",
      "parameters": [
        { "key": "lockStateProperty", "description": "表示锁定状态的属性选择器。", "required": true, "valueShape": "string" },
        { "key": "unlockConditionRefs", "description": "解锁条件定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "kernelOps": ["prop.set", "tag.add", "tag.del"]
    },
    {
      "id": "container.capability.deposit_disabled",
      "name": "禁止存入能力",
      "description": "声明容器只允许取出、不允许存入。该能力与存入能力互斥。",
      "parameters": [
        { "key": "depositEnabled", "description": "存入开关；具备该能力时恒为假。", "required": true, "valueShape": "boolean" }
      ],
      "mutuallyExclusiveWith": ["container.capability.deposit"],
      "kernelOps": []
    },
    {
      "id": "container.capability.derived_content_source",
      "name": "派生内容来源能力",
      "description": "声明容器的初始内容引用不是自行编造的，而是由一次已完成的引擎层变更派生得到；来源标识取自 content-sources 值集。",
      "parameters": [
        { "key": "contentSource", "description": "内容来源标识。", "required": true, "valueShape": "enum<content-sources>" },
        { "key": "contentRefs", "description": "派生得到的内容物品引用集合。", "required": true, "valueShape": "array<reference<item>>" }
      ],
      "kernelOps": ["item.move", "item.create"]
    }
  ],
