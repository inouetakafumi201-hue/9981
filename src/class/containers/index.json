{
  "schemaVersion": "1.0",
  "version": "1.0.0",
  "name": "WakeUp 容器族语义目录",
  "description": "基类层容器语义最小单元目录：随宿主移动的携带容器与固定于空间节点的驻留容器按内容定位关系区分类型身份。容量、访问成本与解锁条件取值全部归玩法层。",
  "category": "containers",
  "semanticFamilies": ["container"],
  "classificationEvidence": {
    "enumerable": true,
    "enumerationRationale": "容器按内容定位关系只有随宿主移动与驻留于节点两种，可有限列举。",
    "composable": true,
    "compositionRationale": "容器类与容量声明、访问条件、存入、取出、上锁、禁止存入、内容来源等能力组合成背包、箱子、货舱、遗留容器等实例。",
    "gameplayIndependent": true,
    "independenceRationale": "容器类不知道自己是背包还是宝箱；容量、访问成本与解锁条件取值全部由玩法层绑定。"
  },
