      "id": "container.valueset.occupancy_metrics",
      "name": "占位度量方式",
      "description": "容量占位的度量方式；度量方式是语义，具体上限是玩法层取值。",
      "tokens": [
        { "id": "item-count", "name": "按件数", "description": "按内容件数计入容量。" },
        { "id": "volume-sum", "name": "按体积和", "description": "按内容体积之和计入容量。" },
        { "id": "slot-count", "name": "按槽位数", "description": "按占用槽位数计入容量。" }
      ]
    },
    {
      "id": "container.valueset.content_sources",
      "name": "内容来源",
      "description": "派生内容来源标识；基类层只声明来源类别，不编造内容。",
      "tokens": [
        { "id": "deceased-entity-transaction", "name": "死亡实体变更", "description": "内容引用由死亡实体的那一次已完成引擎层变更派生。" },
        { "id": "authored-profile", "name": "玩法层编排", "description": "内容引用由玩法层 profile 显式编排。" }
      ]
    }
