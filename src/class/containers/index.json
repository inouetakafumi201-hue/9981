  "prohibitions": [
    {
      "id": "prohibition.container.embedded_capacity_value",
      "diagnosticCode": "SCHEMA_GAMEPLAY_TABLE_IN_L2",
      "statement": "容器类不得内嵌具体容量、访问成本或解锁判据取值。",
      "correction": "只声明参数字段名与度量方式，取值由玩法层提供。"
    },
    {
      "id": "prohibition.container.deposit_conflict",
      "diagnosticCode": "COMPOSE_DUPLICATE_COMPONENT",
      "statement": "同一容器不得同时组合存入能力与禁止存入能力。",
      "correction": "按用途选择其一；遗留容器应只组合禁止存入能力与取出能力。"
    },
    {
      "id": "prohibition.container.invented_content",
      "diagnosticCode": "ITEM_DEATH_CONTAINER_MISSING_TRANSACTION_SOURCE",
      "statement": "派生内容容器不得在缺少来源标识时自行编造内容引用。",
      "correction": "声明 contentSource 并使内容引用由该来源派生。"
    }
