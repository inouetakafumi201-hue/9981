{
  "title": "StatusClass",
  "description": "基类层语义状态定义；具体持续时间、数值、触发来源、解除条件和交互结果由玩法层配置。",
  "type": "object",
  "required": ["id", "name", "category", "type", "description", "capabilityIds", "configurableParameters"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^status_[a-z_]+$",
      "description": "稳定状态类标识。"
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["negative", "positive", "environmental"]
    },
    "type": {
      "type": "string",
      "enum": ["numeric", "tag"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "description": { "type": "string", "minLength": 1 },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^status\\.capability\\.[a-z_]+$" },
      "uniqueItems": true,
      "description": "指向 statuses/index.json 能力登记表的可解析引用；不接受自由散文。"
    },
    "configurableParameters": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "开放给玩法层绑定的参数名；只有名称，没有取值。"
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interactionId", "counterpartRef", "interactionRuleRef"],
        "properties": {
          "interactionId": { "type": "string", "minLength": 1 },
          "counterpartRef": { "type": "string", "pattern": "^status_[a-z_]+$" },
          "interactionRuleRef": { "type": "string", "minLength": 1 }
        }
      },
      "description": "状态交互必须同时声明对手方与显式交互规则引用；交互结果取值归玩法层。"
    }
  }
}
