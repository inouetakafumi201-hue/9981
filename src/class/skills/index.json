  "classes": [
    {
      "id": "skill.class.active",
      "name": "主动技能类",
      "description": "由施动者在自己的行动机会内经付费动作启用的技能类。",
      "defKind": "action",
      "semanticFamily": "skill",
      "abstract": true,
      "activation": "active",
      "typeIdentity": {
        "basis": "required-capability",
        "statement": "主动技能必须绑定一个付费动作作为启用入口；该必需能力使它在决策枚举中出现，被动与触发技能不具备该能力。"
      },
      "requiredCapabilityIds": [
        "skill.capability.activation_action",
        "skill.capability.cost_declaration",
        "skill.capability.effect_binding"
      ],
      "optionalCapabilityIds": [
        "skill.capability.cooldown_declaration",
        "skill.capability.trigger_condition"
      ],
      "parameters": [
        { "key": "activationActionRef", "description": "启用该技能的付费动作引用。", "required": true, "valueShape": "reference<action>" },
        { "key": "costFields", "description": "成本参数字段名集合；成本取值由玩法层绑定。", "required": true, "valueShape": "array<field-name>" },
        { "key": "cooldownFields", "description": "冷却参数字段名集合；冷却取值由玩法层绑定。", "required": false, "valueShape": "array<field-name>" },
        { "key": "effectRefs", "description": "效果定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "forbiddenFieldNames": ["cooldownTurns", "cost", "damage", "duration"],
      "kernelOps": []
    },
    {
      "id": "skill.class.passive",
      "name": "被动技能类",
      "description": "无启用入口、以持续效果形式生效的技能类。",
      "defKind": "rule",
      "semanticFamily": "skill",
      "abstract": true,
      "activation": "passive",
      "typeIdentity": {
        "basis": "invariant",
        "statement": "被动技能的不变量是不存在启用入口与冷却：它不能出现在决策枚举中，也不能声明启用动作或冷却字段。"
      },
      "requiredCapabilityIds": [
        "skill.capability.continuous_effect",
        "skill.capability.effect_binding"
      ],
      "optionalCapabilityIds": [],
      "parameters": [
        { "key": "continuousEffectRefs", "description": "持续效果定义引用集合。", "required": true, "valueShape": "array<reference>" },
        { "key": "effectRefs", "description": "效果定义引用集合。", "required": true, "valueShape": "array<reference>" }
      ],
      "forbiddenFieldNames": ["activationActionRef", "cooldownFields", "cooldownTurns", "cost"],
      "kernelOps": ["attach.add", "attach.del"]
    },
    {
      "id": "skill.class.triggered",
      "name": "触发技能类",
      "description": "无启用入口、在触发条件成立时生效的技能类。",
      "defKind": "rule",
      "semanticFamily": "skill",
      "abstract": true,
      "activation": "triggered",
      "typeIdentity": {
        "basis": "required-capability",
        "statement": "触发技能必须声明触发条件引用且不得声明启用动作；它既不出现在决策枚举中，也不像被动技能那样持续生效。"
      },
      "requiredCapabilityIds": [
        "skill.capability.trigger_condition",
        "skill.capability.effect_binding"
      ],
      "optionalCapabilityIds": ["skill.capability.cooldown_declaration"],
      "parameters": [
        { "key": "triggerConditionRefs", "description": "触发条件定义引用集合；具体阈值由玩法层绑定。", "required": true, "valueShape": "array<reference>" },
        { "key": "effectRefs", "description": "效果定义引用集合。", "required": true, "valueShape": "array<reference>" },
        { "key": "cooldownFields", "description": "冷却参数字段名集合。", "required": false, "valueShape": "array<field-name>" }
      ],
      "forbiddenFieldNames": ["activationActionRef", "cooldownTurns", "cost"],
      "kernelOps": ["attach.add", "attach.del"]
    }
  ],
