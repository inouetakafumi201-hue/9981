        "action.capability.op_mapping",
        "action.capability.presentation_semantics"
      ],
      "parameters": [
        { "key": "actorRequirements", "description": "施动者要求集合引用。", "required": true, "valueShape": "array<actor-requirement>" },
        { "key": "targetRequirements", "description": "目标要求集合引用。", "required": true, "valueShape": "array<target-requirement>" },
        { "key": "effectRefs", "description": "效果定义引用集合；效果取值由玩法层绑定。", "required": true, "valueShape": "array<reference>" },
        { "key": "interruptionConditionRefs", "description": "中断条件引用集合。", "required": true, "valueShape": "array<reference>" },
        { "key": "completionState", "description": "动作完成后进入的显式完成状态标识。", "required": true, "valueShape": "string" },
        { "key": "availableAsDecisionBranch", "description": "是否可作为独立决策分支；付费动作恒为真。", "required": true, "valueShape": "boolean" }
