      "parameters": [
        { "key": "opId", "description": "已注册引擎层操作标识。", "required": true, "valueShape": "op-id" },
        { "key": "argumentMapping", "description": "实参映射集合。", "required": true, "valueShape": "array<op-argument-mapping>" },
