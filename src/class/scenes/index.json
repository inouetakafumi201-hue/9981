        { "key": "microSceneRefs", "description": "附属于该场景的微型场景引用集合。", "required": true, "valueShape": "array<reference<micro-scene>>" },
        { "key": "transitionRefs", "description": "以该场景为端点的过渡连接引用集合。", "required": true, "valueShape": "array<reference<transition>>" }
      ],
      "kernelOps": ["node.create", "node.destroy", "node.merge", "node.split"]
