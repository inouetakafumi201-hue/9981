{
  "schemaVersion": "1.0",
  "version": "3.0.0",
  "name": "WakeUp 物品族语义目录",
  "description": "基类层物品语义目录：只声明可组合的物品类、能力形状、槽位与容器接口以及配置槽位；玩法数值和具体玩法规则由玩法层 profile 提供。",
  "category": "items",
  "semanticFamilies": ["item"],
  "classificationEvidence": {
    "enumerable": true,
    "enumerationRationale": "物品按使用生命周期与装配关系可有限列举为消耗品、工具、装备、配件与弹药五类。",
    "composable": true,
    "compositionRationale": "物品类与恢复、解除、护甲、盾牌、锁具交互、状态赋予、耐用、消耗、弹药供给、配件挂装等能力组合成具体物品实例；防具即装备类加护甲能力的组合实例。",
    "gameplayIndependent": true,
    "independenceRationale": "物品类不知道自己出现在哪种玩法模式，也不携带恢复量、护甲值、容量与耐久取值。"
  },
